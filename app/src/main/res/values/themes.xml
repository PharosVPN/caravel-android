<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A dark, edge-to-edge base theme. The real palette is the Compose
         Material3 theme (Theme.kt); this only governs the splash window so the
         app opens onto the deep-ocean background, not a white flash. -->
    <style name="Theme.Caravel" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ocean</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
